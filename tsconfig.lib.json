{
  "extends": ["./tsconfig.json"],
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true
  },
  "paths": {
    "@pmeig/srv-core": [
      "modules/core"
    ],
    "@pmeig/srv-core/*": [
      "modules/core/src/*"
    ],
    "@pmeig/vault": [
      "modules/vault"
    ],
    "@pmeig/srv-vault/*": [
      "modules/vault/src/*"
    ],
    "@pmeig/srv-properties": [
      "modules/properties"
    ],
    "@pmeig/srv-properties/*": [
      "modules/properties/src/*"
    ]
  }
}
