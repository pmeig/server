{
  "compilerOptions": {
    "target": "ES2024",
    "module": "CommonJS",
    "sourceMap": true,
    "declarationMap": true,
    "declaration": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "strictNullChecks": true,
    "forceConsistentCasingInFileNames": true
  }
}
