{
  "name": "server",
  "type": "library",
  "architecture": {
    "prefix": "@pmeig/srv-",
    "library": {
      "root": "modules"
    }
  },
  "projects": {
    "cli": {
      "type": "library",
      "location": {
        "root": "modules/cli"
      },
      "assets": [
        "**/templates/**",
        "target/plugins/**"
      ]
    },
    "core": {
      "type": "library",
      "location": {
        "root": "modules/core"
      },
      "assets": []
    },
    "runner": {
      "type": "application",
      "location": {
        "root": "runner"
      },
      "assets": []
    },
    "vault": {
      "type": "library",
      "location": {
        "root": "modules/vault"
      },
      "assets": []
    },
    "properties": {
      "type": "library",
      "location": {
        "root": "modules/properties"
      },
      "assets": []
    },
    "rest": {
      "type": "library",
      "location": {
        "root": "modules/rest"
      },
      "assets": []
    },
    "vite-plugin-pmeig": {
      "type": "library",
      "location": {
        "root": "modules/vite-plugin-pmeig"
      },
      "assets": []
    },
    "security": {
      "type": "library",
      "location": {
        "root": "modules/security"
      },
      "assets": []
    }
  }
}