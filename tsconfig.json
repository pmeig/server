{
  "compilerOptions": {
    "target": "ES2024",
    "module": "CommonJS",
    "resolveJsonModule": true,
    "sourceMap": true,
    "declarationMap": true,
    "declaration": true,
    "removeComments": true,
    "strict": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  }
}
